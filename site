<script>
(function(){
  var termBody = document.getElementById('terminalBody');
  var inputRow = document.getElementById('inputRow');
  var input = document.getElementById('cmdInput');
  var hackerFigure = document.getElementById('hackerFigure');
  var agentInfo = document.getElementById('agentInfo');
  var heroCaption = document.getElementById('heroCaption');
  var panelArea = document.getElementById('panelArea');

  var helpUsed = false;

  function scrollBottom(){ termBody.scrollTop = termBody.scrollHeight; }

  function addLine(text, cls, keyAttr){
    var div = document.createElement('div');
    div.className = 't-line' + (cls ? ' ' + cls : '');
    if (keyAttr) div.setAttribute('data-key', keyAttr);
    termBody.appendChild(div);
    return div;
  }

  function typeInto(el, text, speed, cb){
    var i = 0;
    var cursor = document.createElement('span');
    cursor.className = 'cursor';
    el.appendChild(document.createTextNode(''));
    function step(){
      if (i <= text.length){
        el.textContent = text.slice(0, i);
        if (i < text.length){ el.appendChild(cursor); }
        i++;
        scrollBottom();
        setTimeout(step, speed);
      } else {
        if (cb) cb();
      }
    }
    step();
  }

  function wait(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }

  function typeLinePromise(cls, text, speed, keyAttr){
    return new Promise(function(resolve){
      var el = addLine('', cls, keyAttr);
      typeInto(el, text, speed || 16, function(){ resolve(el); });
    });
  }

  async function bootSequence(){
    await wait(400);
    await typeLinePromise(null, 'Имя: its_roxio', 22, 'name');
    await wait(150);
    await typeLinePromise(null, 'Специализация: Security Engineer, Network security specialist.', 14, 'role');
    await wait(150);
    await typeLinePromise(null, 'Команды: Blue & Purple', 22, 'team');
    await wait(400);
    addLine('', null);
    await typeLinePromise('ok', '[ОК] Загрузка системы управления портфолио . . .', 16);
    await wait(250);
    await typeLinePromise(null, 'Добро пожаловать в систему . . .', 20);
    await wait(250);
    await typeLinePromise('muted', 'Для работы с системой используйте команду help', 14);
    await wait(200);
    enableInput();
  }

  function enableInput(){
    inputRow.classList.remove('disabled');
    input.focus();
  }

  function echoCommand(cmd){
    addLine('guest@portfolio : ~ $ ' + cmd, 'cmd');
    scrollBottom();
  }

  function fadeRemove(el){
    if (!el) return;
    el.classList.add('fading');
    setTimeout(function(){ if (el.parentNode) el.parentNode.removeChild(el); }, 520);
  }

  function transformHelp(){
    helpUsed = true;

    // 1. remove the intro lines from the terminal transcript
    ['name','role','team'].forEach(function(k){
      var el = termBody.querySelector('.t-line[data-key="' + k + '"]');
      fadeRemove(el);
    });

    // 2. hide the hooded figure
    hackerFigure.classList.add('gone');

    // 3. hide the CIA / slogan caption
    heroCaption.classList.add('gone');

    // 4. reveal the same info in its place, typed line by line
    agentInfo.style.display = 'block';
    var lines = agentInfo.querySelectorAll('.line');
    lines.forEach(function(l, idx){
      setTimeout(function(){ l.classList.add('show'); }, 200 + idx * 350);
    });
  }

  var TILES = [
    { cmd:'about',    title:'Обо мне' },
    { cmd:'skills',   title:'Навыки и инструменты' },
    { cmd:'projects', title:'Проекты и кейсы' },
    { cmd:'contact',  title:'Контакты для связи' }
  ];

  function renderHelpTiles(){
    var old = termBody.querySelector('.tile-grid');
    if (old) fadeRemove(old);

    setTimeout(function(){
      var grid = document.createElement('div');
      grid.className = 'tile-grid';
      TILES.forEach(function(t){
        var tile = document.createElement('div');
        tile.className = 'mini-tile';
        tile.setAttribute('data-cmd', t.cmd);
        tile.innerHTML = '<span class="cmdname">' + t.cmd + '</span><span class="desc">' + t.title + '</span>';
        tile.addEventListener('click', function(){
          input.value = t.cmd;
          runCommand(t.cmd);
        });
        grid.appendChild(tile);
      });
      termBody.appendChild(grid);
      scrollBottom();
    }, old ? 200 : 0);
  }

  var SKILLS = [
    ['TCP/IP', 'Basic'],
    ['DNS', 'Basic'],
    ['HTTP/HTTPS', 'Basic'],
    ['VPN', 'Proficient'],
    ['Linux', 'Working knowledge'],
    ['Windows', 'Proficient'],
    ['Python', 'Junior+ / Middle-'],
    ['Bash', 'Working knowledge'],
    ['PowerShell', 'Working knowledge'],
    ['Wireshark', 'Basic'],
    ['Nmap', 'Basic'],
    ['Законодательство РФ в сфере ИБ', 'Working knowledge']
  ];

  var PROJECTS = [
    {
      title: 'OSINT_recon',
      desc: 'Проект, собирающий информацию о сайтах и серверах компании. Дополнительно указывает документы компании. Использует технологии и сервисы OSINT, разрешённые законодательством РФ.',
      link: 'https://github.com/its-roxio/OSINT_recon'
    }
  ];

  var CONTACTS = [
    { net:'Telegram', val:'@its_roxio', href:'https://t.me/its_roxio' },
    { net:'GitHub', val:'github.com/its-roxio', href:'https://github.com/its-roxio' },
    { net:'Discord', val:'its_roxio', href: 'https://discordapp.com/users/523877918204755968' }
  ];

  function clearPanel(cb){
    var existing = panelArea.querySelectorAll('.panel-heading, .panel-grid, .about-text, .empty-hint');
    if (!existing.length){ cb(); return; }
    existing.forEach(function(el){
      el.style.transition = 'opacity .3s ease';
      el.style.opacity = '0';
    });
    setTimeout(function(){
      panelArea.innerHTML = '';
      cb();
    }, 300);
  }

  function heading(tag, title){
    var wrap = document.createElement('div');
    wrap.className = 'panel-heading';
    wrap.innerHTML = '<span class="tag">' + tag + '</span><h2>' + title + '</h2>';
    return wrap;
  }

  function showAbout(){
    clearPanel(function(){
      panelArea.appendChild(heading('$ about', 'Обо мне'));
      var card = document.createElement('div');
      card.className = 'comet-card';
      card.innerHTML = '<div class="comet-inner"><p class="about-text" id="aboutText"></p></div>';
      panelArea.appendChild(card);
      var target = card.querySelector('#aboutText');
      typeInto(target, 'Меня зовут Ник, мне 20 лет. Учусь в РТУ МИРЭА, специальность 10.03.01. Увлекаюсь программированием, информационной безопасностью, информационными и сетевыми технологиями. Люблю изучать и совершенствовать операционные системы. Умею концентрироваться на задачах, проявлять инициативность. Люблю узнавать новое и стараюсь применять полученные знания на практике. Ответственно подхожу к выполнению возложенных на меня обязанностей.', 8, function(){});
    });
  }

  function showSkills(){
    clearPanel(function(){
      panelArea.appendChild(heading('$ skills', 'Навыки и инструменты'));
      var grid = document.createElement('div');
      grid.className = 'panel-grid cols-3';
      SKILLS.forEach(function(s, idx){
        var card = document.createElement('div');
        card.className = 'comet-card';
        card.style.animationDelay = (idx * 0.05) + 's';
        card.innerHTML = '<div class="comet-inner"><div class="skill-name">' + s[0] + '</div><span class="skill-level">' + s[1] + '</span></div>';
        grid.appendChild(card);
      });
      panelArea.appendChild(grid);
    });
  }

  function showProjects(){
    clearPanel(function(){
      panelArea.appendChild(heading('$ projects', 'Проекты и кейсы'));
      var grid = document.createElement('div');
      grid.className = 'panel-grid cols-2';
      PROJECTS.forEach(function(p, idx){
        var card = document.createElement('div');
        card.className = 'comet-card';
        card.style.animationDelay = (idx * 0.05) + 's';
        card.innerHTML = '<div class="comet-inner">' +
          '<div class="proj-title">' + p.title + '</div>' +
          '<div class="proj-desc">' + p.desc + '</div>' +
          '<a class="proj-link" href="' + p.link + '" target="_blank" rel="noopener">GitHub &rarr;</a>' +
          '</div>';
        grid.appendChild(card);
      });
      panelArea.appendChild(grid);
    });
  }

  function showContact(){
    clearPanel(function(){
      panelArea.appendChild(heading('$ contact', 'Контакты для связи'));
      var grid = document.createElement('div');
      grid.className = 'panel-grid cols-3';
      CONTACTS.forEach(function(c, idx){
        var card = document.createElement('div');
        card.className = 'comet-card';
        card.style.animationDelay = (idx * 0.05) + 's';
        var valHtml = c.href ? '<a href="' + c.href + '" target="_blank" rel="noopener">' + c.val + '</a>' : c.val;
        card.innerHTML = '<div class="comet-inner"><div class="contact-net">' + c.net + '</div><div class="contact-val">' + valHtml + '</div></div>';
        grid.appendChild(card);
      });
      panelArea.appendChild(grid);
    });
  }

  function runCommand(raw){
    var cmd = raw.trim().toLowerCase();
    if (!cmd) return;
    echoCommand(raw.trim());

    if (cmd === 'help'){
      if (!helpUsed) transformHelp();
      renderHelpTiles();
    } else if (cmd === 'about'){
      showAbout();
    } else if (cmd === 'skills'){
      showSkills();
    } else if (cmd === 'projects'){
      showProjects();
    } else if (cmd === 'contact'){
      showContact();
    } else {
      addLine('Команда не найдена: ' + cmd + '. Введите help для списка команд.', 'err');
      scrollBottom();
    }
    input.value = '';
  }

  input.addEventListener('keydown', function(e){
    if (e.key === 'Enter'){
      runCommand(input.value);
    }
  });

  document.querySelectorAll('.topbar nav span').forEach(function(el){
    el.addEventListener('click', function(){
      var cmd = el.getAttribute('data-cmd');
      if (!helpUsed){ transformHelp(); renderHelpTiles(); }
      input.value = cmd;
      runCommand(cmd);
    });
  });

  bootSequence();
})();
</script>
</body>
</html>
