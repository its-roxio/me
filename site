<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>its_roxio // security portfolio</title>
<meta name="description" content="its_roxio — Security Engineer, Network security specialist. Blue &amp; Purple team portfolio.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #060a0f;
    --bg-raise: #0b131c;
    --bg-panel: #0e1720;
    --line: #16232f;
    --blue: #2b6cb0;
    --blue-bright: #5aa9e6;
    --teal: #21d4c0;
    --teal-dim: #12897c;
    --white: #eaf2f8;
    --muted: #7f97a8;
    --danger: #e0554f;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:
      radial-gradient(circle at 15% 10%, rgba(43,108,176,0.10), transparent 45%),
      radial-gradient(circle at 85% 0%, rgba(33,212,192,0.08), transparent 40%),
      var(--bg);
    color:var(--white);
    font-family:'Space Grotesk', sans-serif;
    min-height:100vh;
  }

  ::selection{ background:var(--teal); color:#06110f; }

  a{ color:var(--teal); }

  /* ---------- top bar ---------- */
  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    padding:22px clamp(20px,5vw,64px);
    border-bottom:1px solid var(--line);
  }
  .brand{
    font-family:'JetBrains Mono', monospace;
    font-size:15px; letter-spacing:0.06em;
    display:flex; align-items:center; gap:10px;
  }
  .brand-dot{ width:9px; height:9px; border-radius:50%; background:var(--teal); box-shadow:0 0 8px var(--teal); }
  .brand b{ color:var(--teal); font-weight:700; }
  .topbar nav{ display:flex; gap:22px; font-family:'JetBrains Mono', monospace; font-size:13px; color:var(--muted); }
  .topbar nav span{ cursor:pointer; }
  .topbar nav span:hover{ color:var(--teal); }
  @media (max-width:640px){ .topbar nav{ display:none; } }

  /* ---------- hero ---------- */
  .hero{
    display:grid;
    grid-template-columns:1fr 1fr;
    min-height:640px;
    border-bottom:1px solid var(--line);
  }
  @media (max-width:900px){
    .hero{ grid-template-columns:1fr; min-height:auto; }
  }

  /* --- terminal half --- */
  .terminal-side{
    padding:clamp(20px,4vw,48px);
    display:flex; align-items:center; justify-content:center;
    border-right:1px solid var(--line);
  }
  @media (max-width:900px){ .terminal-side{ border-right:none; border-bottom:1px solid var(--line); } }

  .terminal{
    width:100%; max-width:620px;
    background:var(--bg-raise);
    border:1px solid var(--line);
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 0 0 1px rgba(33,212,192,0.03), 0 30px 60px -30px rgba(0,0,0,0.6);
  }
  .terminal-bar{
    display:flex; align-items:center; gap:8px;
    padding:11px 14px;
    background:#0a121a;
    border-bottom:1px solid var(--line);
  }
  .tb-dot{ width:10px; height:10px; border-radius:50%; }
  .tb-dot.r{ background:#e0554f; }
  .tb-dot.y{ background:#e0b04f; }
  .tb-dot.g{ background:#4fbf7a; }
  .terminal-bar span{
    margin-left:10px;
    font-family:'JetBrains Mono', monospace;
    font-size:12px; color:var(--muted);
  }
  .terminal-body{
    padding:18px 18px 6px;
    font-family:'JetBrains Mono', monospace;
    font-size:13.5px;
    line-height:1.65;
    height:290px;
    overflow-y:auto;
    scrollbar-width:thin;
    scrollbar-color:var(--line) transparent;
  }
  .terminal-body::-webkit-scrollbar{ width:6px; }
  .terminal-body::-webkit-scrollbar-thumb{ background:var(--line); border-radius:6px; }

  .t-line{ white-space:pre-wrap; word-break:break-word; color:var(--white); transition:opacity .5s ease, max-height .5s ease, margin .5s ease; }
  .t-line.fading{ opacity:0; max-height:0; margin:0; overflow:hidden; }
  .t-line.ok{ color:var(--teal); }
  .t-line.muted{ color:var(--muted); }
  .t-line.cmd{ color:var(--blue-bright); }
  .t-line.err{ color:var(--danger); }
  .cursor{
    display:inline-block; width:8px; height:15px;
    background:var(--teal); margin-left:2px;
    animation:blink 1s step-end infinite; vertical-align:-2px;
  }
  @keyframes blink{ 50%{ opacity:0; } }

  .tile-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:8px;
    margin:10px 0 8px;
  }
  @media (max-width:420px){ .tile-grid{ grid-template-columns:1fr; } }
  .mini-tile{
    border:1px solid var(--line); border-radius:6px;
    padding:8px 10px; cursor:pointer;
    background:rgba(33,212,192,0.03);
    transition:border-color .2s ease, background .2s ease;
  }
  .mini-tile:hover{ border-color:var(--teal-dim); background:rgba(33,212,192,0.07); }
  .mini-tile .cmdname{ color:var(--teal); font-weight:700; }
  .mini-tile .desc{ color:var(--muted); font-size:11.5px; display:block; margin-top:2px; }

  .terminal-input-row{
    display:flex; align-items:center; gap:8px;
    padding:12px 18px 16px;
    border-top:1px solid var(--line);
    font-family:'JetBrains Mono', monospace;
    font-size:13.5px;
  }
  .prompt-label{ color:var(--blue-bright); white-space:nowrap; }
  .terminal-input-row input{
    flex:1; background:transparent; border:none; outline:none;
    color:var(--white); font-family:'JetBrains Mono', monospace; font-size:13.5px;
    caret-color:var(--teal);
  }
  .terminal-input-row input::placeholder{ color:var(--muted); opacity:.6; }
  .terminal-input-row.disabled input{ pointer-events:none; opacity:.4; }

  /* --- hacker half --- */
  .hacker-side{
    padding:clamp(24px,4vw,48px);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; position:relative;
  }
  .hacker-figure{
    width:min(280px, 70%);
    transition:opacity .6s ease, transform .6s ease, filter .6s ease;
  }
  .hacker-figure.gone{
    opacity:0; transform:scale(.92) translateY(6px); pointer-events:none;
    position:absolute;
  }

  .agent-info{
    font-family:'JetBrains Mono', monospace;
    font-size:14px; line-height:1.9; color:var(--white);
    min-height:120px;
    max-width:420px;
  }
  .agent-info .k{ color:var(--muted); }
  .agent-info .v{ color:var(--teal); }
  .agent-info .line{ opacity:0; transform:translateY(4px); transition:opacity .4s ease, transform .4s ease; }
  .agent-info .line.show{ opacity:1; transform:none; }

  .hero-caption{
    margin-top:22px; transition:opacity .5s ease, max-height .5s ease;
  }
  .hero-caption.gone{ opacity:0; max-height:0; overflow:hidden; margin-top:0; }
  .cia-line{
    font-family:'JetBrains Mono', monospace;
    letter-spacing:0.08em; font-size:12.5px; color:var(--blue-bright);
    text-transform:uppercase;
  }
  .slogan{
    margin:8px 0 0; font-size:clamp(18px,2.4vw,24px); font-weight:600;
    color:var(--white);
  }
  .slogan span{ color:var(--teal); }

  /* ---------- panel area ---------- */
  .panel-area{
    padding:clamp(24px,5vw,56px) clamp(20px,5vw,64px) 80px;
    min-height:120px;
  }
  .panel-heading{
    display:flex; align-items:baseline; gap:12px; margin-bottom:26px;
  }
  .panel-heading .tag{
    font-family:'JetBrains Mono', monospace; color:var(--teal); font-size:13px;
  }
  .panel-heading h2{
    font-size:clamp(20px,3vw,28px); margin:0; font-weight:600;
  }
  .panel-grid{
    display:grid; gap:16px;
  }
  .panel-grid.cols-2{ grid-template-columns:repeat(2,1fr); }
  .panel-grid.cols-3{ grid-template-columns:repeat(3,1fr); }
  @media (max-width:760px){
    .panel-grid.cols-2, .panel-grid.cols-3{ grid-template-columns:1fr; }
  }

  .comet-card{
    position:relative; border-radius:14px; opacity:0; transform:translateY(10px);
    animation:cardIn .5s ease forwards;
  }
  @keyframes cardIn{ to{ opacity:1; transform:none; } }
  .comet-card::before{
    content:""; position:absolute; inset:-1px; border-radius:15px; padding:1.5px;
    background:conic-gradient(from 0deg, transparent 0deg, var(--teal) 26deg, var(--blue-bright) 55deg, transparent 100deg, transparent 360deg);
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor; mask-composite:exclude;
    animation:cometSpin 3.2s linear infinite;
  }
  @keyframes cometSpin{ to{ transform:rotate(360deg); } }
  .comet-inner{
    position:relative; background:var(--bg-panel); border-radius:13px;
    padding:20px 22px; height:100%;
  }

  .about-text{
    font-size:16px; line-height:1.85; color:var(--white);
    max-width:1700px;
  }

  .skill-name{ font-weight:600; font-size:15px; }
  .skill-level{ font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--teal); margin-top:6px; display:inline-block; }

  .proj-title{ font-weight:600; font-size:16px; margin-bottom:8px; }
  .proj-desc{ font-size:13.5px; color:var(--muted); line-height:1.6; margin-bottom:14px; }
  .proj-link{
    font-family:'JetBrains Mono', monospace; font-size:13px;
    display:inline-flex; align-items:center; gap:6px;
    color:var(--teal); text-decoration:none; border-bottom:1px solid var(--teal-dim);
    padding-bottom:2px;
  }
  .proj-link:hover{ color:var(--blue-bright); border-color:var(--blue-bright); }

  .contact-net{ font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
  .contact-val{ font-size:16px; font-weight:600; margin-top:8px; }
  .contact-val a{ color:var(--white); text-decoration:none; }
  .contact-val a:hover{ color:var(--teal); }

  .empty-hint{
    font-family:'JetBrains Mono', monospace; color:var(--muted); font-size:13px;
  }
  .empty-hint b{ color:var(--teal); }

  footer{
    border-top:1px solid var(--line); padding:22px clamp(20px,5vw,64px);
    font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--muted);
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;
  }

  @media (prefers-reduced-motion:reduce){
    .comet-card::before{ animation:none; }
    .comet-card{ animation:none; opacity:1; transform:none; }
    .cursor{ animation:none; }
  }
</style>
</head>
<body>

<div class="topbar">
